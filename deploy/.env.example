# Copy to .env next to docker-compose.yml and adapt.

# Image published by GitHub Actions (owner/repo in lowercase).
WAVESHARE_IMAGE=ghcr.io/votre-compte/simul-ws:latest

# LAN IP of the Docker host (Proxmox LXC/VM) — reported in Modbus FC04.
WAVESHARE_IP=192.168.1.50
WAVESHARE_NETMASK=255.255.255.0
#WAVESHARE_GATEWAY=192.168.1.1

# Ports exposed on the LAN. Use 502 for the standard Modbus port.
HOST_MODBUS_PORT=5020
HOST_WEB_PORT=8080

WAVESHARE_MAC=02:57:53:52:4C:08
WAVESHARE_DEVICE_ADDRESS=1
WAVESHARE_STRICT_UNIT_ID=false
WAVESHARE_VERBOSE=false
TZ=Europe/Paris
